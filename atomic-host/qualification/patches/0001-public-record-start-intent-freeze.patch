+    /// Freeze an exact active declared turn for an external recorder. A
+    /// successful result is native UID-binding evidence, not task authority,
+    /// source-readiness evidence or proof that a record was published.
+    pub fn freeze_turn_intent_for_record(
+        &self,
+        session_id: &str,
+        expected_turn: u32,
+        expected_intent_uid: &str,
+    ) -> AgentResult<TurnIntentBinding> {
+        use fs2::FileExt;
+
+        validate_session_id(session_id)?;
+        let failure = |reason: String| AgentError::SessionSaveFailed {
+            session_id: session_id.to_owned(),
+            reason,
+        };
+        let dir = self.sessions_dir.join(session_id);
+        let lock = std::fs::OpenOptions::new()
+            .create(true)
+            .write(true)
+            .truncate(false)
+            .open(dir.join("turn-end.lock"))?;
+        lock.try_lock_exclusive()
+            .map_err(|error| failure(format!("turn recording is already owned: {error}")))?;
+        let session = self.load(session_id)?
+            .ok_or_else(|| failure("unknown session".into()))?;
+        if session.session_id != session_id || !session.is_turn_active()
+            || session.is_ended() || session.incomplete().is_some()
+            || session.turn_count.checked_add(1) != Some(expected_turn)
+        {
+            return Err(failure("stale or inactive exact turn".into()));
+        }
+        let binding = self.turn_intent_binding(session_id, expected_turn)?
+            .ok_or_else(|| failure("exact turn has no declared intent".into()))?;
+        if binding.intent_uid != expected_intent_uid || expected_intent_uid.trim().is_empty() {
+            return Err(failure("declared governing intent differs".into()));
+        }
+        // The existing native freeze primitive requires turn-end.lock. This
+        // facade owns it through the durable marker write.
+        self.freeze_turn_intent(session_id, expected_turn)?;
+        Ok(binding)
+    }
+
